// ───────── Config (générée par Prisma 7, on n'y touche pas) ─────────
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums : des listes fermées de valeurs ─────────
enum Role {
  ADMIN
  COACH
  JOUEUR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EN_ATTENTE
}

// ───────── Les 9 tables ─────────
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nom       String
  role      Role
  createdAt DateTime @default(now())

  player  Player? // un User PEUT être un joueur (0 ou 1)
  coachOn Coach[] // un User peut coacher plusieurs équipes
}

model Club {
  id     String  @id @default(uuid())
  nom    String
  logo   String?
  saison String

  teams   Team[]
  players Player[]
}

model Team {
  id     String @id @default(uuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id])
  nom    String
  ageMin Int
  ageMax Int

  rosters Roster[]
  coaches Coach[]
  games   Game[]
}

model Player {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  clubId        String
  club          Club     @relation(fields: [clubId], references: [id])
  dateNaissance DateTime
  taille        Int?
  poids         Int?

  rosters     Roster[]
  attendances Attendance[]
  stats       Stat[]
}

model Roster {
  id       String @id @default(uuid())
  playerId String
  player   Player @relation(fields: [playerId], references: [id])
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id])
  numero   Int
  poste    String

  @@unique([playerId, teamId])
}

model Coach {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Game {
  id         String   @id @default(uuid())
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id])
  adversaire String
  date       DateTime
  lieu       String
  domicile   Boolean

  attendances Attendance[]
  stats       Stat[]
}

model Attendance {
  id       String           @id @default(uuid())
  gameId   String
  game     Game             @relation(fields: [gameId], references: [id])
  playerId String
  player   Player           @relation(fields: [playerId], references: [id])
  statut   AttendanceStatus @default(EN_ATTENTE)

  @@unique([gameId, playerId])
}

model Stat {
  id             String @id @default(uuid())
  gameId         String
  game           Game   @relation(fields: [gameId], references: [id])
  playerId       String
  player         Player @relation(fields: [playerId], references: [id])
  passesTentees  Int    @default(0)
  passesReussies Int    @default(0)
  yards          Int    @default(0)
  plaquages      Int    @default(0)
  touchdowns     Int    @default(0)

  @@unique([gameId, playerId])
}
