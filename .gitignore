dist/
build/
.next/          # web (si Next un jour)
.expo/          # mobile (Expo)
web-build/

# ─── Logs ──────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*

# ─── OS / IDE ──────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
# On ignore les réglages perso VS Code, mais on garde
# la liste d'extensions recommandées pour l'équipe :
.vscode/*
!.vscode/extensions.json

# ─── Tests ─────────────────────────────────────
coverage/


